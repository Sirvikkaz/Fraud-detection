pipeline {
  agent any
  environment {
    ECR_REPOSITORY = credentials('ECR_REPOSITORY')
    AWS_ACCOUNT_ID = credentials('AWS_ACCOUNT_ID')
    AWS_ACCESS_KEY_ID = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
  }
  
  stages {
    stage('Continuous Integration') {
      steps {
        script {
          echo "Linting repository"
          echo "Running unit tests"
        }
      }
    }

    stage('Login to ECR') {
      steps {
        script {
          sh 'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com'
        }

      }
    }

    stage('Download Models') {
    steps {
        script {
            sh '''
            mkdir -p models
            aws s3 cp s3://fraud-model-452110701928/models models --recursive
            echo "Downloaded models:"
            ls -R models
            '''
        }
    }
}


    stage('Build Image') {
      steps {
        script {
          sh '''
            echo "Current directory:"
            pwd

            echo "Repository contents:"
            ls -R
            '''
          sh """
          docker build --no-cache -t ${ECR_REPOSITORY}:latest .
          docker run --rm ${ECR_REPOSITORY}:latest ls -R /app/models
          """
        }
      }
    }

    stage('Verify Image') {
    steps {
        script {
            sh """
            echo "Checking models inside built image..."
            docker run --rm ${ECR_REPOSITORY}:latest ls -R /app/models
            """
        }
    }
}

    stage('Push Image') {
      steps {
        script {
          sh 'docker push ${ECR_REPOSITORY}:latest'
        }
      }
    }

    stage('Verify Pushed Image') {
    steps {
        script {
            sh """
            echo "Removing local image..."
            docker rmi -f ${ECR_REPOSITORY}:latest || true

            echo "Pulling image back from ECR..."
            docker pull ${ECR_REPOSITORY}:latest

            echo "Checking models inside pulled image..."
            docker run --rm ${ECR_REPOSITORY}:latest ls -R /app/models
            """
        }
    }
}

    stage('Continuous Deployment') {
      steps {
        sshagent(['ssh_key']) {
          sh "ssh -o StrictHostKeyChecking=no -l ubuntu 54.159.98.186 'cd /home/ubuntu/ && wget -O docker-compose.yaml https://raw.githubusercontent.com/Sirvikkaz/Fraud-detection/refs/heads/main/docker-compose.yaml && export IMAGE_NAME=${ECR_REPOSITORY}:latest && aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com && docker compose pull && docker compose up -d'"
        }
      }
    }
  }

  post {
    always {
      sh 'docker system prune -f'
    }
  }
}